package com.finnova.bank.banking;
import java.time.Clock;
import java.time.temporal.ChronoUnit;
import java.util.List;
import java.util.Map;
import java.util.UUID;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.finnova.bank.audit.*;
import com.finnova.bank.auth.domain.Role;
import com.finnova.bank.banking.BankingDtos.*;
import com.finnova.bank.common.*;
import org.springframework.http.HttpStatus;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.*;
@Service
public class TransferTransactionService {
    private final AccountRepository accounts;
    private final LedgerRepository ledger;
    private final IdempotencyService idempotency;
    private final BankingAccess access;
    private final TransferPolicy policy;
    private final AuditService audit;
    private final ObjectMapper mapper;
    private final Clock clock;
    public TransferTransactionService(AccountRepository accounts,LedgerRepository ledger,IdempotencyService idempotency,
            BankingAccess access,TransferPolicy policy,AuditService audit,ObjectMapper mapper,Clock clock){
        this.accounts=accounts;this.ledger=ledger;this.idempotency=idempotency;this.access=access;
        this.policy=policy;this.audit=audit;this.mapper=mapper;this.clock=clock;
    }
    private record Prepared(BankAccount source,BankAccount target,TransferPolicy.Balances balances) { }
    @Transactional(isolation=Isolation.READ_COMMITTED)
    @PreAuthorize("hasRole('CUSTOMER') and #userId==authentication.principal.id()")
    public IdempotentReply execute(long userId,String key,TransferPolicy.Canonical request){
        IdempotencyRecord reservation=idempotency.reserve(userId,"TRANSFER",key,request.fingerprint());
        // The reservation FK holds a shared users-row lock. Recheck live account/
        // session state AFTER reserving; concurrent revocation must complete first.
        long customer=access.customer(userId);
        if(reservation.completed())return idempotency.replay(reservation);
        Prepared prepared;
        try {
            // Count projection only: do not cache stale balance entities before locking.
            if (accounts.countOwned(customer, List.of(request.source())) != 1) {
    throw new ApiException(HttpStatus.NOT_FOUND, "Account not found.");
}
            long low=Math.min(request.source(),request.target());
            long high=Math.max(request.source(),request.target());
            BankAccount first=accounts.lockById(low).orElseThrow(()->new ApiException(HttpStatus.NOT_FOUND,"Account not found."));
            BankAccount second=accounts.lockById(high).orElseThrow(()->new ApiException(HttpStatus.NOT_FOUND,"Account not found."));
            BankAccount source=request.source()==low?first:second;
            BankAccount target=request.target()==low?first:second;
            if (source.getCustomerId() != customer) {
                throw new ApiException(HttpStatus.NOT_FOUND, "Account not found.");
            }
            if (accounts.countEligibleCustomerRecipient(target.getId()) != 1) {
                throw new ApiException(HttpStatus.NOT_FOUND, "Account not found.");
            }
            if(source.getStatus()!=BankAccount.Status.ACTIVE || target.getStatus()!=BankAccount.Status.ACTIVE)
                throw new ApiException(HttpStatus.CONFLICT,"Both accounts must be active.");
            if(!"INR".equals(source.getCurrency()) || !source.getCurrency().equals(target.getCurrency()))
                throw new ApiException(HttpStatus.CONFLICT,"Both accounts must use INR.");
            prepared=new Prepared(source,target,policy.balances(source.getBalance(),target.getBalance(),request.amount()));
        }catch(ApiException expected){
            // All expected business checks precede every money/ledger mutation.
            // Cache these completed business rejections too, without changing balances.
            ApiError error=new ApiError(clock.instant(),expected.status().value(),expected.status().getReasonPhrase(),expected.getMessage(),"/api/transfers",List.of());
            audit.record(AuditActor.user(userId,Role.CUSTOMER),"TRANSFER_REJECTED","FAILURE","TRANSFER",null,Map.of("reason",expected.getMessage()));
            return idempotency.complete(reservation,expected.status().value(),mapper.valueToTree(error));
        }
        var now=clock.instant().truncatedTo(ChronoUnit.MICROS);
        String reference=UUID.randomUUID().toString();
        prepared.source().applyBalance(prepared.balances().source(),now);
        prepared.target().applyBalance(prepared.balances().target(),now);
        // Execute the balance SQL now, still UNCOMMITTED. The fault-injection test
        // can then prove real balance/debit SQL is rolled back on a credit failure.
        accounts.flush();
        String description = request.note().isBlank()
        ? "SIMULATED transfer"
        : "SIMULATED transfer: " + request.note();
        ledger.save(new FinancialTransaction(request.source(),request.target(),reference,"DEBIT","TRANSFER_DEBIT",request.amount(),
                prepared.source().getBalance(),description,userId,reservation.getId(),now));
        ledger.save(new FinancialTransaction(request.target(),request.source(),reference,"CREDIT","TRANSFER_CREDIT",request.amount(),
                prepared.target().getBalance(),description,userId,reservation.getId(),now));
        audit.record(AuditActor.user(userId,Role.CUSTOMER),"TRANSFER","SUCCESS","TRANSFER",reference,
                Map.of("amount",request.amount().toPlainString(),"sourceAccountId",request.source(),"targetAccountId",request.target(),"synthetic",true));
        var body=new TransferView(reference,request.source(),request.target(),request.amount(),prepared.source().getBalance(),prepared.target().getBalance(),now,true);
        // Unexpected persistence failures are NOT caught: the entire transaction,
        // both balances, both entries, reservation and audit must roll back together.
        return idempotency.complete(reservation,HttpStatus.CREATED.value(),mapper.valueToTree(body));
    }
}

