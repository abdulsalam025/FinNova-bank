# The database setup script creates the real, ignored .env file.
# Load it using: . .\scripts\Use-FinNovaEnvironment.ps1
# Values may be plain text or JSON-quoted strings; the provided loader handles both.
# Never paste .env, its values, or a password into chat or screenshots.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=finnova_demo
DB_APP_USERNAME=finnova_app
DB_APP_PASSWORD="GENERATED_BY_SETUP_NOT_A_REAL_PASSWORD"
DB_MIGRATION_USERNAME=finnova_migrator
DB_MIGRATION_PASSWORD="GENERATED_BY_SETUP_NOT_A_REAL_PASSWORD"
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Initialize-FinNovaSecurity.ps1 generates the real signing key privately.
AUTH_JWT_SECRET="GENERATED_LOCALLY_NOT_A_REAL_KEY"
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_TOKEN_TTL_SECONDS=900
