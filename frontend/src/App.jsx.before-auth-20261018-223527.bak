import { Link, NavLink, Route, Routes } from "react-router-dom";
import SystemStatusPage from "./pages/SystemStatusPage.jsx";

function HomePage() {
  return (
    <section className="row align-items-center g-4 py-lg-4" aria-labelledby="home-heading">
      <div className="col-lg-7">
        <p className="eyebrow">FINNOVA BANK / COLLEGE LAB</p>
        <h1 id="home-heading" className="display-5 fw-bold">A solid foundation for intelligent banking.</h1>
        <p className="lead text-body-secondary my-4">
          Banking and loan management built in verified stages.
          This first stage establishes the frontend, backend, and their connection.
        </p>
        <Link to="/system-status" className="btn btn-primary btn-lg">Check backend connection</Link>
        <p className="small text-body-secondary mt-3">Synthetic data only. No real money or banking connections.</p>
      </div>
      <div className="col-lg-5">
        <aside className="card border-0 shadow-sm p-2" aria-labelledby="scope-heading">
          <div className="card-body">
            <h2 id="scope-heading" className="h5 mb-3">Project scope</h2>
            <ul className="list-group list-group-flush">
              <li className="list-group-item px-0 d-flex justify-content-between gap-3">
                <span>API connectivity</span><span className="scope-label">Check status page</span>
              </li>
              <li className="list-group-item px-0 d-flex justify-content-between gap-3">
                <span>Customer banking</span><span className="scope-label">Coming soon</span>
              </li>
              <li className="list-group-item px-0 d-flex justify-content-between gap-3">
                <span>Loan workflows</span><span className="scope-label">Coming soon</span>
              </li>
              <li className="list-group-item px-0 d-flex justify-content-between gap-3">
                <span>Officer and admin tools</span><span className="scope-label">Coming soon</span>
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </section>
  );
}

function NotFoundPage() {
  return (
    <section>
      <h1 className="h2">Page not found</h1>
      <p>This route is not available.</p>
      <Link to="/" className="btn btn-primary">Return home</Link>
    </section>
  );
}

export default function App() {
  return (
    <div className="app-shell">
      <a className="skip-link" href="#main-content">Skip to content</a>
      <header className="bg-white border-bottom">
        <nav className="navbar container py-3 gap-3" aria-label="Main navigation">
          <Link className="navbar-brand fw-bold m-0" to="/">
            <span className="brand-mark me-2" aria-hidden="true">F</span>FinNova Bank
          </Link>
          <div className="d-flex align-items-center flex-wrap gap-3">
            <NavLink className={({ isActive }) => `nav-link ${isActive ? "active" : ""}`} to="/" end>Home</NavLink>
            <NavLink className={({ isActive }) => `nav-link ${isActive ? "active" : ""}`} to="/system-status">System status</NavLink>
            <span className="badge simulation-badge">SIMULATION ONLY</span>
          </div>
        </nav>
      </header>
      <main id="main-content" className="container flex-grow-1 py-5" tabIndex={-1}>
        <Routes>
          <Route path="/" element={<HomePage />} />
          <Route path="/system-status" element={<SystemStatusPage />} />
          <Route path="*" element={<NotFoundPage />} />
        </Routes>
      </main>
      <footer className="container py-4 small text-body-secondary border-top">
        Stage 1 scaffold. INR locale / Asia/Kolkata display timezone. Not a production banking service.
      </footer>
    </div>
  );
}
