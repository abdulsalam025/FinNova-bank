import { useCallback, useEffect, useRef, useState } from "react";
import { listAccounts } from "../api/accounts.js";
import { createTransfer } from "../api/transfers.js";

function errorText(error) {
  return (
    error?.response?.data?.message ||
    error?.response?.data?.detail ||
    error?.response?.data?.error ||
    error?.message ||
    "The request failed. Please try again."
  );
}

function money(value, currency = "INR") {
  return new Intl.NumberFormat("en-IN", {
    style: "currency",
    currency,
    maximumFractionDigits: 2,
  }).format(Number(value ?? 0));
}

export default function TransferPage() {
  const [accounts, setAccounts] = useState([]);
  const [sourceId, setSourceId] = useState("");
  const [targetId, setTargetId] = useState("");
  const [amount, setAmount] = useState("");
  const [note, setNote] = useState("");
  const [loadingAccounts, setLoadingAccounts] = useState(true);
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");
  const idempotencyKey = useRef(null);

  const loadAccounts = useCallback(async () => {
    setLoadingAccounts(true);
    try {
      const data = await listAccounts({
        page: 0,
        size: 100,
        sortBy: "createdAt",
        sortDirection: "DESC",
      });
      const items = Array.isArray(data) ? data : data?.items ?? [];
      setAccounts(items);
      setSourceId((current) => {
        if (items.some((a) => String(a.id) === current && a.status === "ACTIVE")) {
          return current;
        }
        return String(items.find((a) => a.status === "ACTIVE")?.id ?? "");
      });
    } catch (err) {
      setError(errorText(err));
    } finally {
      setLoadingAccounts(false);
    }
  }, []);

  useEffect(() => {
    loadAccounts();
  }, [loadAccounts]);

  const sourceAccount = accounts.find((account) => String(account.id) === sourceId);
  const parsedAmount = Number(amount);
  const validAmount = Number.isFinite(parsedAmount) && parsedAmount >= 0.01;
  const eligibleTargets = accounts.filter(
    (account) =>
      account.status === "ACTIVE" &&
      account.currency === "INR" &&
      String(account.id) !== sourceId
  );
  const targetAccount = eligibleTargets.find(
    (account) => String(account.id) === targetId
  );
  const validTarget = Boolean(targetAccount);

  async function handleSubmit(event) {
    event.preventDefault();
    setError("");
    setNotice("");

    if (!sourceAccount || sourceAccount.status !== "ACTIVE") {
      setError("Choose an active source account.");
      return;
    }
    if (!validTarget) {
      setError("Choose an eligible destination account different from the source.");
      return;
    }
    if (!validAmount || !/^\d+(\.\d{1,2})?$/.test(amount.trim())) {
      setError("Enter an amount of at least ₹0.01, with no more than two decimal places.");
      return;
    }
    if (parsedAmount > Number(sourceAccount.balance)) {
      setError("The amount exceeds the displayed source balance. The backend will perform the final balance check.");
      return;
    }
    if (note.length > 120) {
      setError("The note must be 120 characters or fewer.");
      return;
    }

    setSubmitting(true);
    if (!idempotencyKey.current) {
      idempotencyKey.current = globalThis.crypto?.randomUUID?.();
    }
    if (!idempotencyKey.current) {
      setError("This browser cannot generate a secure request ID. Please use an up-to-date browser.");
      setSubmitting(false);
      return;
    }

    try {
      await createTransfer(
        {
          sourceAccountId: Number(sourceId),
          targetAccountId: Number(targetId),
          amount: amount.trim(),
          note: note.trim() || null,
        },
        idempotencyKey.current
      );
      idempotencyKey.current = null;
      setNotice("Transfer request completed. Check Transactions to confirm the recorded result.");
      setAmount("");
      setNote("");
      setTargetId("");
      await loadAccounts();
    } catch (err) {
      // Retain the same idempotency key when retrying this request.
      setError(errorText(err));
    } finally {
      setSubmitting(false);
    }
  }

  return (
    <main className="container py-4 py-lg-5">
      <div className="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
          <p className="text-primary fw-semibold mb-1">BANKING OPERATIONS</p>
          <h1 className="h2 fw-bold mb-1">Transfer Money</h1>
          <p className="text-secondary mb-0">Transfer between eligible accounts.</p>
        </div>
        <button className="btn btn-outline-primary" onClick={loadAccounts} disabled={loadingAccounts}>
          Refresh accounts
        </button>
      </div>

      {error && <div className="alert alert-danger" role="alert">{error}</div>}
      {notice && <div className="alert alert-success" role="status">{notice}</div>}

      <div className="row g-4">
        <div className="col-lg-7">
          <section className="card border-0 shadow-sm">
            <div className="card-body p-4">
              <h2 className="h5 fw-bold mb-4">Transfer details</h2>
              {loadingAccounts ? (
                <p className="text-secondary mb-0">Loading your accounts…</p>
              ) : accounts.filter((a) => a.status === "ACTIVE").length === 0 ? (
                <div className="alert alert-warning mb-0">
                  You need an active account before you can make a transfer.
                </div>
              ) : (
                <form onSubmit={handleSubmit}>
                  <div className="mb-3">
                    <label htmlFor="sourceAccount" className="form-label">From account</label>
                    <select
                      id="sourceAccount"
                      className="form-select"
                      value={sourceId}
                      onChange={(event) => {
                        setSourceId(event.target.value);
                        idempotencyKey.current = null;
                      }}
                      required
                    >
                      {accounts.filter((a) => a.status === "ACTIVE").map((account) => (
                        <option key={account.id} value={account.id}>
                          {account.nickname} · ID {account.id} · {money(account.balance, account.currency)}
                        </option>
                      ))}
                    </select>
                    {sourceAccount && (
                      <div className="form-text">
                        {sourceAccount.accountType} · Account ending {String(sourceAccount.accountNumber ?? "").slice(-4)}
                      </div>
                    )}
                  </div>

                  <div className="mb-3">
                    <label htmlFor="targetAccountId" className="form-label">Destination account</label>
                    <select
                      id="targetAccountId"
                      className="form-select"
                      value={targetId}
                      onChange={(event) => {
                        setTargetId(event.target.value);
                        idempotencyKey.current = null;
                      }}
                      required
                    >
                      <option value="">Choose a destination account</option>
                      {eligibleTargets.map((account) => (
                        <option key={account.id} value={account.id}>
                          {account.nickname} · ID {account.id} · {money(account.balance, account.currency)}
                        </option>
                      ))}
                    </select>
                    <div className="form-text">
                      Only other active INR accounts in your account list are shown.
                    </div>
                  </div>

                  <div className="mb-3">
                    <label htmlFor="transferAmount" className="form-label">Amount (INR)</label>
                    <div className="input-group">
                      <span className="input-group-text">₹</span>
                      <input
                        id="transferAmount"
                        className="form-control"
                        type="number"
                        min="0.01"
                        step="0.01"
                        value={amount}
                        onChange={(event) => {
                          setAmount(event.target.value);
                          idempotencyKey.current = null;
                        }}
                        placeholder="0.00"
                        required
                      />
                    </div>
                  </div>

                  <div className="mb-4">
                    <label htmlFor="transferNote" className="form-label">Note (optional)</label>
                    <input
                      id="transferNote"
                      className="form-control"
                      type="text"
                      maxLength={120}
                      value={note}
                      onChange={(event) => {
                        setNote(event.target.value);
                        idempotencyKey.current = null;
                      }}
                      placeholder="e.g. Shared expenses"
                    />
                    <div className="form-text">{note.length}/120 characters</div>
                  </div>

                  <button
                    className="btn btn-primary w-100 py-2"
                    type="submit"
                    disabled={submitting || loadingAccounts || !sourceId}
                  >
                    {submitting ? "Processing transfer…" : "Submit transfer"}
                  </button>
                  <p className="small text-secondary mt-3 mb-0">
                    Review the destination carefully. The server is responsible for final authorization and balance validation.
                  </p>
                </form>
              )}
            </div>
          </section>
        </div>

        <div className="col-lg-5">
          <section className="card border-0 shadow-sm mb-4">
            <div className="card-body p-4">
              <h2 className="h6 fw-bold">Source account balance</h2>
              <p className="display-6 fw-bold mb-1">
                {sourceAccount ? money(sourceAccount.balance, sourceAccount.currency) : "—"}
              </p>
              <p className="text-secondary small mb-0">
                Displayed balance may change. The backend must recheck available funds when processing the transfer.
              </p>
            </div>
          </section>
          <section className="card border-0 bg-light">
            <div className="card-body p-4">
              <h2 className="h6 fw-bold">Transfer checklist</h2>
              <ul className="small text-secondary mb-0 ps-3">
                <li className="mb-2">Choose an active source account.</li>
                <li className="mb-2">Confirm the destination account ID.</li>
                <li className="mb-2">Enter an amount with up to two decimal places.</li>
                <li>Check the Transactions page after submitting.</li>
              </ul>
            </div>
          </section>
        </div>
      </div>
    </main>
  );
}


